<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The PTIT News</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous"> -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/../css/trangDanhMuc2.css">
    <link rel="stylesheet" href="/../css/admin2.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="../css/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .pagination a {
            color: #007bff;
            padding: 8px 12px;
            text-decoration: none;
            border: 1px solid #ddd;
            margin: 0 4px;
            border-radius: 4px;
            transition: 0.3s;
        }

        .pagination a:hover {
            background-color: #e9ecef;
        }

        .pagination a.active {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }
    </style>
    <script src="//cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>    

</head>

<body>
    <div class="sidebar">
        <div class="logo_content">
            <div class="logo-container">
                <img src="../assets/logoWhite.png" />
            </div>

            <i class="bi bi-list fs-3" id="btn"></i>
        </div>

        <ul class="nav_list">
            <li>
                <a href="#">
                    <i class="bi bi-person-circle"></i>
                    <span class="links_name">Thông tin cá nhân</span>
                </a>
                <span class="tooltip">Thông tin cá nhân</span>
            </li>
            <% if (_locals.role=="NhaBao" ) { %>
                <li>
                    <a href="#">
                        <i class="bi bi-person-badge"></i>
                        <span class="links_name">Thông tin nhà báo</span>
                    </a>
                    <span class="tooltip">Thông tin nhà báo</span>
                </li>
                <li>
                    <a href="#">
                        <i class="bi bi-bar-chart"></i>
                        <span class="links_name">Danh sách bài viết</span>
                    </a>
                    <span class="tooltip">Danh sách bài viết</span>
                </li>
                <% } %>
                    <% if (_locals.role=="NhaBao" || _locals.role=="Admin" ) { %>
                        <li>
                            <a href="#">
                                <i class='bx bxs-plus-circle'></i>
                                <span class="links_name">Thêm bài báo</span>
                            </a>
                            <span class="tooltip">Thêm bài báo</span>
                        </li>
                        <% } %>
                            <% if (_locals.role=="Admin" ) { %>
                                <li>
                                    <a href="#">
                                        <i class='bx bxs-bar-chart-square'></i>
                                        <span class="links_name">Thống kê dữ liệu</span>
                                    </a>
                                    <span class="tooltip">Thống kê dữ liệu</span>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class='bx bxs-folder-open'></i>
                                        <span class="links_name">Quản lý bài viết</span>
                                    </a>
                                    <span class="tooltip">Quản lý bài viết</span>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class='bx bxs-category-alt'></i>
                                        <span class="links_name">Quản lý danh mục</span>
                                    </a>
                                    <span class="tooltip">Quản lý danh mục</span>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class='bx bxs-user'></i>
                                        <span class="links_name">Quản lý người dùng</span>
                                    </a>
                                    <span class="tooltip">Quản lý người dùng</span>
                                </li>
                                <li>
                                    <a href="#">
                                        <i class='bx bxs-comment-detail'></i>
                                        <span class="links_name">Quản lý bình luận</span>
                                    </a>
                                    <span class="tooltip">Quản lý bình luận</span>
                                </li>
                                <% } %>
                                    <li style="margin-top: 50px; margin-right: 10px; padding-right: 10px;">
                                        <form action="/home" method="GET" style="height: 50px;">
                                            <button style="    
                                            background-color: transparent;
                                            border: none;
                                            color: white;
                                            font-size: 20px;
                                            height: 100%;
                                            " 
                                            type="submit">
                                                <i class='bx bx-log-out' style="padding-right: 15px !important;"></i>
                                                <span class="links_name" style="font-size: medium;">Quay lại</span>
                                            </button>
                                        </form>
                                        <span class="tooltip">Quay lại</span>
                                    </li>
        </ul>
    </div>

    <div class="home_content">

        <div id="infoManagement" class="info_management" style="display: block;">
            <h2 class="info_management-title">Thông tin cá nhân</h2>
            <div class="info_management-flex">
                <div class="info_management-content">
                    <!-- Họ và Tên -->
                    <form action="/auth/changePwdQuanTri" method="POST">
                        <div class="info_management-row">
                            <label class="info_management-label">Họ và Tên:</label>
                            <div class="info_management-input-group">
                                <input type="text" id="info_management-name" class="info_management-input"
                                    name="newUsername" value="<%= user[0].username %>" disabled>
                            </div>
                        </div>
                        <!-- Email (không chỉnh sửa, thêm placeholder) -->
                        <div class="info_management-row">
                            <label class="info_management-label">Email:</label>
                            <div class="info_management-input-group">
                                <input type="email" id="info_management-email" class="info_management-input"
                                    value="<%= user[0].email %>" disabled>
                                <div class="info_management-email-placeholder"></div>
                            </div>
                        </div>
                        <!-- Mật khẩu -->
                        <div class="info_management-row">
                            <label class="info_management-label">Mật khẩu:</label>
                            <div class="info_management-input-group">
                                <input type="password" id="info_management-password" class="info_management-input"
                                    name="pwdInp" value="<%= user[0].password %>" disabled>
                                <div class="info_management-button-group">
                                    <button type="button" id="info_management-change-password"
                                        class="info_management-button">🔑</button>
                                </div>
                                <div class="info_management-button-group">
                                    <button type="submit" id="info_management-edit-name" class="info_management-button"
                                        style="display:none"><i class="bi bi-floppy-fill"></i></button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="info_management-side">
                    <div class="info_management-tabs">
                        <button class="info_management-tab active" data-tab="favorite-articles">Bài viết yêu
                            thích</button>
                        <button class="info_management-tab" data-tab="my-comments">Bình luận của tôi</button>
                    </div>

                    <div class="info_management-tab-content" id="favorite-articles" style="display:block;">
                        <div class="info_management-table-actions">
                            <!-- Đã xóa nút Thêm -->
                        </div>
                        <table class="info_management-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Bài viết</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (let k=0; k < likeArticles.length; k++) { %>
                                    <tr>
                                        <td>
                                            <%= k + 1 %>
                                        </td>
                                        <td class="center-items-table">
                                            <div class="search-items"
                                                style="background: transparent; margin-bottom: 0px">
                                                <div class="image-like" style="width: 300px !important;">
                                                    <a
                                                        href="/article/transportArticle/<%= likeArticles[k].name_alias %>">
                                                        <img src="<%= likeArticles[k].hero_image %>" alt="" style="width: 300px !important; height: 100% !important;">
                                                    </a>
                                                </div>
                                                <div class="content">
                                                    <a href="/article/transportArticle/<%=likeArticles[k].name_alias %>"
                                                        style="text-decoration: none;">
                                                        <div class="title-section">
                                                            <%= likeArticles[k].heading %>
                                                        </div>
                                                    </a>
                                                    <div class="date">
                                                        <%= likeArticles[k].day_created %>
                                                    </div>
                                                    <div class="description">
                                                        <p>
                                                            <a
                                                                href="/article/transportArticle/<%= likeArticles[k].name_alias %>">
                                                                <%= likeArticles[k].content %>
                                                            </a>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <form action="/article/removeArticle/<%= likeArticles[k].name_alias %>"
                                                method="POST">
                                                <button class="info_management-action-btn">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="info_management-tab-content" id="my-comments" style="display:none;">
                        <div class="info_management-table-actions">
                            <!-- Đã xóa nút Thêm -->
                        </div>
                        <table class="info_management-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Bài viết</th>
                                    <th>Nội dung bình luận</th>
                                    <th>Ngày bình luận</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (let k=0; k < userComments.length; k++) { %>
                                    <tr>
                                        <td>
                                            <%= k + 1 %>
                                        </td>
                                        <td>
                                            <%= userComments[k].ten_bai_viet %>
                                        </td>
                                        <td>
                                            <%= userComments[k].noi_dung_binh_luan %>
                                        </td>
                                        <td>
                                            <%= userComments[k].ngay_binh_luan %>
                                        </td>
                                        <td>
                                            <form action="/comment/removeComment/<%= userComments[k].id_comment %>" method="POST">
                                                <button class="info_management-action-btn">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <div id="info-nhabao-Management" class="info_management" style="display: none;">
            <h2 class="info_management-title">Thông tin nhà báo</h2>
            <div class="info_management-flex">
                <div class="info_management-content">
                    <div class="info_management-row">
                        <label class="info_management-label">Họ và Tên:</label>
                        <div class="info_management-input-group">
                            <input type="text" id="info_management-name" class="info_management-input"
                                value="Nguyễn Văn A" disabled>
                            <div class="info_management-button-group">
                                <button id="info_management-edit-name" class="info_management-button">✏️</button>
                            </div>
                        </div>
                    </div>
                    <div class="info_management-row">
                        <label class="info_management-label">Email:</label>
                        <div class="info_management-input-group">
                            <input type="email" id="info_management-email" class="info_management-input"
                                value="nguyenvana@gmail.com" disabled>
                            <div class="info_management-email-placeholder"></div>
                        </div>
                    </div>
                    <div class="info_management-row">
                        <label class="info_management-label">Mật khẩu:</label>
                        <div class="info_management-input-group">
                            <input type="password" id="info_management-password" class="info_management-input"
                                value="passwordcc" disabled>
                            <div class="info_management-button-group">
                                <button id="info_management-change-password" class="info_management-button">🔑</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="info_management-side">
                    <div class="statistic-overview">
                        <div class="statistic-box">
                            <div class="statistic-number" id="statisticTotalArticles">0</div>
                            <div class="statistic-label">Tổng số bài viết</div>
                        </div>
                        <div class="statistic-box">
                            <div class="statistic-number" id="statisticTotalViews">0</div>
                            <div class="statistic-label">Tổng lượt xem</div>
                        </div>
                        <div class="statistic-box">
                            <div class="statistic-number" id="statisticTotalLikes">0</div>
                            <div class="statistic-label">Tổng lượt thích</div>
                        </div>
                        <div class="statistic-box">
                            <div class="statistic-number" id="statisticTotalComments">0</div>
                            <div class="statistic-label">Tổng bình luận</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="statistic-nhabao-Management" class="info_management" style="display: none;">
            <h2 class="info_management-title">Thống kê của nhà báo</h2>
            <div class="info_management-flex">
                <div class="info_management-side" style="width:100%">
                    <div class="info_management-tabs">
                        <button class="info_management-tab active" data-tab="statistic-my-articles">Danh sách bài viết
                            của tôi</button>
                        <button class="info_management-tab" data-tab="statistic-approve-notify">Thông báo bài viết được
                            duyệt</button>
                    </div>
                    <div class="info_management-tab-content" id="statistic-my-articles" style="display:block;">
                        <table class="info_management-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tiêu đề</th>
                                    <th>Lượt xem</th>
                                    <th>Lượt thích</th>
                                    <th>Ngày đăng</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="statisticMyArticlesBody"></tbody>
                        </table>
                    </div>
                    <div class="info_management-tab-content" id="statistic-approve-notify" style="display:none;">
                        <ul id="statisticApproveNotifyList" style="padding-left: 18px;">
                            <!-- Thông báo sẽ được render ở đây -->
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div id="staticManagement" class="static_management" style="display: none;">
            <h2>Thống kê dữ liệu</h2>
        </div>

        <div id="postManagement" class="post_management" style="display: none;">
            <h2>Quản lý bài viết</h2>
            <div class="search-container">
                <div class="search-container-box">
                    <div class="search-box" id="search-box1">
                        <input type="text" placeholder="Tìm kiếm...">
                        <label class="search-icon" id="search-icon1">
                            <i class="bi bi-search"></i>
                        </label>
                    </div>
                </div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>ID bài báo</th>
                        <th>Tác giả</th>
                        <th>ID danh mục</th>
                        <th>Bài viết</th>
                        <th>Số lượt xem</th>
                        <th>Số lượt thích</th>
                        <th>Nổi bật</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="tbodyArticle">
                    <% if (articles && articles.length) { %>
                        <% for (let i = 0; i < articles.length; i++) { %>
                            <tr data-article-id="<%= articles[i].id_article %>">
                                <td><%= articles[i].id_article %></td>
                                <td><%= articles[i].id_user %></td>
                                <td><%= articles[i].id_category %></td>
                                <td style="width: 100px;">
                                    <div class="search-items" style="background: transparent; margin-bottom: 0px; width: 700px; height: auto; text-align: left !important;">
                                        <div class="image" style="width: 150px;">
                                            <a href="/article/checkArticle/<%= articles[i].name_alias %>">
                                                <img src="<%= articles[i].hero_image %>" alt="" style="width: 150px;">
                                            </a>
                                        </div>
                                        <div class="content">
                                            <a href="/article/checkArticle/<%=articles[i].name_alias %>" style="text-decoration: none;  "><div class="title-section" style="font-size: 18px;"><%= articles[i].heading %></div></a>
                                            <div class="date" style="font-size: 16px;"><%= articles[i].day_created %></div>
                                            <div class="description">
                                                <p>
                                                    <a href="/article/checkArticle/<%= articles[i].name_alias %> ">
                                                        <div style="font-size: 16px;">
                                                            <%= articles[i].content %>
                                                        </div>
                                                    </a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td><%= articles[i].views %></td>
                                <td><%= articles[i].like_count %></td>
                                <td>
                                    <label class="featured-checkbox">
                                        <input type="checkbox" 
                                               class="featured-toggle" 
                                               data-article-id="<%= articles[i].id_article %>"
                                               <%= articles[i].is_featured ? 'checked' : '' %>>
                                        <span class="checkmark"></span>
                                    </label>
                                </td>
                                <td>
                                    <label class="status-checkbox">
                                        <input type="checkbox" 
                                               class="status-toggle" 
                                               data-article-id="<%= articles[i].id_article %>"
                                               <%= articles[i].status === 'Đã duyệt' ? 'checked' : '' %>>
                                        <span class="checkmark"></span>
                                    </label>
                                </td>
                                <td>
                                    <button class="btn btn-primary btn-sm" style="margin-bottom: 5px;" onclick="editArticle('<%= articles[i].id_article %>')">Sửa</button>
                                    <button class="btn btn-danger btn-sm" onclick="showDeleteModal('<%= articles[i].id_article %>')">Xóa</button>
                                </td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="13" class="text-center">Không có bài viết nào</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <div class="pagination">
                <% if (pagination.articles.totalPages> 1) { %>
                    <% for (let i=1; i <=pagination.articles.totalPages; i++) { %>
                        <a href="?articlePage=<%= i %>&userPage=<%= pagination.users.currentPage %>&categoryPage=<%= pagination.categories.currentPage %>&section=articles#articles"
                            class="<%= i === pagination.articles.currentPage ? 'active' : '' %>">
                            <%= i %>
                        </a>
                        <% } %>
                            <% } %>
            </div>


            <div id="editPostModal" class="action-modal-overlay">
                <div class="action-modal-content" id ="editPostModalContent" style="gap: 20px!important;">
                    <button class="action-modal-close">&times;</button>
                    <div class="action-modal-header">
                        <h2>Chỉnh sửa bài báo</h2>
                    </div>

                    <div class="action-form-group">
                        <label>Tên Bài báo</label>
                        <input type="text" id="editPostTitle" placeholder="Nhập tên bài báo">
                    </div>

                    <div class="action-form-group">
                        <label>Tên nhà báo</label>
                        <input type="text" id="editPostAuthorId" placeholder="Nhập tên nhà báo">
                    </div>

                    <div class="action-form-group">
                        <label>Danh mục chính</label>
                        <select id="editMainCategory">
                            <option value="" disabled selected>Chọn danh mục chính</option>
                            <option value="society">Xã hội</option>
                            <option value="science">Khoa học & Công nghệ</option>
                            <option value="health">Sức khỏe</option>
                            <option value="sports">Thể Thao</option>
                            <option value="entertainment">Giải trí</option>
                            <option value="education">Giáo dục</option>
                        </select>
                    </div>

                    <div class="action-form-group">
                        <label>Danh mục phụ</label>
                        <select id="editSubCategory">
                            <option value="" disabled selected>Chọn danh mục phụ</option>
                        </select>
                    </div>

                    <div class="action-form-group">
                        <label>Ảnh</label>
                        <input type="text" id="editPostHeroImage" placeholder="Image">
                    </div>

                    <div class="action-form-group">
                        <label>Link bài báo</label>
                        <input type="text" id="editPostNameAlias" placeholder="Link bài báo">
                    </div>

                    <div class="action-form-group">
                        <label>Nổi bật</label>
                        <select id="editIsFeatured">
                            <option value="false">Không</option>
                            <option value="true">Có</option>
                        </select>
                    </div>

                    <div class="action-form-group" style="grid-column: 1 / -1;">
                        <label>Nội dung bài báo</label>
                        <textarea id="editPostContent" placeholder="Nhập nội dung bài báo"></textarea>
                    </div>
                    

                    <div class="action-modal-footer">
                        <button id="btnUpdatePost" class="btn-edit">Cập nhật bài báo</button>
                    </div>
                    
                </div>
            </div>

            <div id="deletePostModal" class="delete-modal">
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 20px; border-radius: 5px; text-align: center; min-width: 300px;">
                    <p>Bạn có chắc chắn muốn xóa bài báo này không?</p>
                    <div style="display: flex; justify-content: center; gap: 10px; margin-top: 15px;">
                        <form id="formDeleteArticle" action="" method="POST">
                            <button type="submit" class="btn-confirm">Có</button>
                        </form>
                        <button onclick="hideDeleteModal()" class="btn-cancel">Không</button>
                    </div>
                </div>
            </div>


        </div>

        <div id="categoryManagement" class="category_management" style="display: none;">
            <h2>Quản lý danh mục</h2>
            <div class="search-container">
                <div class="search-container-box">
                        <div class="search-box">
                            <form id='userSearchBar' action="/backdetails" method="GET">
                                <input type="text" name="searchInpCate" placeholder="Tìm kiếm...">
                                <button type="submit"> <i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>
                <button class="add-category-btn">Thêm danh mục</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>ID danh mục</th>
                        <th>Danh mục cha</th>
                        <th>Tên danh mục</th>
                        <th>Tên alias</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="tbodyCategories">
                    <% if (categories && categories.length) { %>
                        
                        <% for (let i = 0; i < categories.length; i++) { %>
                            <tr>
